# Hartley & Moor — local development
DATABASE_URL="file:./dev.db"
# PostgreSQL (production or docker-compose): uncomment and switch the
# provider in prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://hartley:hartley@localhost:5432/caravan"
NEXTAUTH_SECRET="dev-secret-change-in-production-32charsmin"
NEXTAUTH_URL="http://localhost:3000"
# Stripe test mode (optional — demo payment mode is used when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Email (optional — notifications are logged when unset)
RESEND_API_KEY=""
EMAIL_FROM="bookings@hartleyandmoor.example"
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="owner@hartleyandmoor.example"
