# Wattle & Wander — local development (PostgreSQL via `docker compose up -d db`)
DATABASE_URL="postgresql://hartley:hartley@localhost:5432/caravan?schema=public"
NEXTAUTH_SECRET="dev-secret-change-in-production-32charsmin"
NEXTAUTH_URL="http://localhost:3000"
HANDOVER_OTP_SECRET="dev-otp-secret-change-in-production-32ch"
# Demo staff login (development only; leave unset in production).
DEMO_OWNER_PASSWORD="owner1234"
AUTH_ALLOW_DEMO="true"
# App canonical URL (metadata, same-origin checks, sitemap).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="owner@wattleandwander.com.au"
# Stripe test mode (optional — demo/log payment mode is used when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Email (optional — notifications are logged when unset)
RESEND_API_KEY=""
EMAIL_FROM="bookings@wattleandwander.com.au"
# Scheduled jobs: bearer token for POST /api/cron/expire-holds (every 5 min).
# Generate: openssl rand -base64 32
CRON_SECRET=""
# Seed guard: must be "true" to run `npm run seed` outside development.
ALLOW_SEED=""
# Build-time sitemap date override (optional, defaults to 2026-01-01).
NEXT_PUBLIC_BUILD_TIME=""
# Trust X-Forwarded-For only behind a trusted proxy/CDN (Vercel: "1").
TRUST_PROXY=""
# Shared rate limiting across replicas (Upstash Redis REST). Unset = per-instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
